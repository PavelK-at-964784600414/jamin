{
  "build": {
    "env": {
      "FFMPEG_LAMBDA": "true",
      "FFMPEG_LAMBDA_LAYER_ARN": "arn:aws:lambda:us-east-2:904233133341:layer:ffmpeg:1",
      "TARGET_PLATFORM": "linux",
      "TARGET_ARCH": "x64",
      "NODE_OPTIONS": "--max-old-space-size=4096",
      "PNPM_FLAGS": "--shamefully-hoist"
    }
  },
  "functions": {
    "app/api/**/*.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "installCommand": "pnpm install && pnpm approve-builds @ffmpeg-installer/linux-x64"
}
